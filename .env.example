# GitHub Personal Access Token (可选)
# 公开仓库可以不填, 但添加后会提升 API 速率限制 (60→5000/小时)
# 获取方式: GitHub Settings → Developer settings → Personal access tokens → Fine-grained tokens
GITHUB_TOKEN=

# LLM API 配置
# 支持任何兼容 OpenAI API 的模型服务
LLM_API_KEY=your-deepseek-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# LLM 参数
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# 服务配置
HOST=0.0.0.0
PORT=8000
